rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email.lower() == 'dannaolivo@gmail.com' ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        )
      );
    }

    function walletFieldsUntouched() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'creditBalance',
        'membership',
        'membershipStatus',
        'membershipExpiresAt',
        'stripeCustomerId',
        'stripeSubscriptionId',
        'stripeCheckoutSessionId',
        'stripePaymentIntentId',
        'entitledCourseIds',
        'assessmentPurchased',
        'assessmentPurchasedAt',
        'assessmentPurchaseType',
        'promoCodeUsed'
      ]);
    }

    // Existing academy/commerce collections (keep as-is)
    match /carts/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /orders/{orderId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    match /pendingOrders/{id} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId)
        && !request.resource.data.keys().hasAny([
          'creditBalance',
          'membership',
          'membershipStatus',
          'membershipExpiresAt',
          'stripeCustomerId',
          'stripeSubscriptionId',
          'stripeCheckoutSessionId',
          'stripePaymentIntentId',
          'entitledCourseIds',
          'assessmentPurchased',
          'assessmentPurchasedAt',
          'assessmentPurchaseType',
          'promoCodeUsed'
        ]);
      allow update: if isAdmin() || (
        isOwner(userId)
        && walletFieldsUntouched()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
      );
      allow delete: if isAdmin();
    }

    match /users/{userId}/{document=**} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false;
    }

    // Username uniqueness check happens before login
    match /usernames/{username} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    match /BHC_Assessment/{sectionId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /sectionResults/{resultId} {
      allow read: if isAdmin() || (
        isSignedIn() && resource.data.userId == request.auth.uid
      );
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin() || (
        isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
      );
      allow delete: if isAdmin();
    }

    match /assessmentFeedback/{id} {
      allow read: if isAdmin() || (
        isSignedIn() && resource.data.userId == request.auth.uid
      );
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /feedback/{id} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /bugReports/{id} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /reportContent/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /mail/{id} {
      allow read, write: if false;
    }
  }
}
